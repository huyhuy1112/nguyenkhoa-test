<?php
/*+***********************************************************************************
 * Poll Google Sheet → create modern Leads (new rows only). Frequency: 60s.
 *************************************************************************************/

require_once 'modules/Leads/models/SheetImportService.php';

try {
	global $current_user;
	if (empty($current_user) || empty($current_user->id)) {
		$current_user = Users::getActiveAdminUser();
	}
	Leads_SheetImportService::installSchema();
	$result = Leads_SheetImportService::pollOnce();
	if (!empty($result['summary'])) {
		echo $result['summary'];
	} elseif (!empty($result['skipped'])) {
		echo 'Sheet poll skipped (disabled).';
	} elseif (!empty($result['error'])) {
		echo 'Sheet poll error: ' . $result['error'];
	} else {
		echo 'Sheet poll done.';
	}
} catch (Exception $e) {
	echo 'Sheet poll exception: ' . $e->getMessage();
}
