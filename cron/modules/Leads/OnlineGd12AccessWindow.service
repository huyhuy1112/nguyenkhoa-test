	Leads_OnlineGd12Service::installSchema();
	$result = Leads_OnlineGd12Service::processAccessWindowTags(300);
	echo 'Online GD1.2 access window: scanned=' . (isset($result['scanned']) ? $result['scanned'] : 0)
		. ' updated=' . (isset($result['updated']) ? $result['updated'] : 0);
} catch (Exception $e) {
	echo 'Online GD1.2 access window exception: ' . $e->getMessage();
}
