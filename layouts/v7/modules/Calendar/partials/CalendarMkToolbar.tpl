{strip}
<div class="mk-cal-toolbar" id="mk-cal-toolbar">
	<div class="mk-cal-toolbar__title-wrap">
		<h1 class="mk-cal-toolbar__title" id="mk-cal-toolbar-title">Tháng 5 năm 2026</h1>
	</div>
	<div class="mk-cal-toolbar__views" role="tablist" aria-label="Calendar view">
		<button type="button" class="mk-cal-view-tab" data-view="day" role="tab">Ngày</button>
		<button type="button" class="mk-cal-view-tab is-active" data-view="week" role="tab" aria-selected="true">Tuần</button>
		<button type="button" class="mk-cal-view-tab" data-view="month" role="tab">Tháng</button>
		<button type="button" class="mk-cal-view-tab" data-view="agenda" role="tab">Lịch trình</button>
	</div>
	<div class="mk-cal-toolbar__nav">
		<button type="button" class="mk-cal-nav-btn mk-cal-nav-btn--today" id="mk-cal-today">Hôm nay</button>
		<div class="mk-cal-nav-arrows">
			<button type="button" class="mk-cal-nav-arrow" id="mk-cal-prev" aria-label="Previous">&lsaquo;</button>
			<button type="button" class="mk-cal-nav-arrow" id="mk-cal-next" aria-label="Next">&rsaquo;</button>
		</div>
		<button type="button" class="mk-cal-nav-icon" id="mk-cal-picker" aria-label="Pick date">
			<svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
				<rect x="2.25" y="3.75" width="13.5" height="11.25" rx="2" stroke="#504533" stroke-width="1.2"/>
				<path d="M6 2.25V5.25M12 2.25V5.25M2.25 8.25H15.75M6 12.75H12M6 15.75H12" stroke="#504533" stroke-width="1.2" stroke-linecap="round"/>
			</svg>
		</button>
	</div>
</div>
{/strip}