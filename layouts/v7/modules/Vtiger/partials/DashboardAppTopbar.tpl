{strip}
{assign var=TOPBAR_USER_ID value=$CURRENT_USER_ID|default:$CURRENT_USER_MODEL->get('id')}
{assign var=TOPBAR_FIRST_NAME value={decode_html($CURRENT_USER_MODEL->get('first_name'))}}
{assign var=TOPBAR_LAST_NAME value={decode_html($CURRENT_USER_MODEL->get('last_name'))}}
{assign var=TOPBAR_FULL_NAME value=$TOPBAR_FIRST_NAME|cat:' '|cat:$TOPBAR_LAST_NAME}
{assign var=TOPBAR_FULL_NAME value=$TOPBAR_FULL_NAME|trim}
{if empty($TOPBAR_FULL_NAME)}
	{assign var=TOPBAR_FULL_NAME value={decode_html($CURRENT_USER_MODEL->get('user_name'))}}
{/if}
{assign var=TOPBAR_ROLE_NAME value=$CURRENT_USER_MODEL->getUserRoleName()}
{assign var=TOPBAR_AVATAR_URL value=''}
{foreach from=$CURRENT_USER_MODEL->getImageDetails() item=TOPBAR_IMG_ROW}
{if $TOPBAR_AVATAR_URL eq '' && !empty($TOPBAR_IMG_ROW.url)}
	{assign var=TOPBAR_AVATAR_URL value=$TOPBAR_IMG_ROW.url}
{/if}
{/foreach}
{assign var=TOPBAR_DEFAULT_AVATAR value='layouts/v7/resources/Images/default-user-avatar.png'}
{assign var=TOPBAR_INITIALS value=''}
{if $TOPBAR_FIRST_NAME neq ''}
	{assign var=TOPBAR_INITIALS value=$TOPBAR_FIRST_NAME|substr:0:1|upper}
{/if}
{if $TOPBAR_LAST_NAME neq ''}
	{assign var=TOPBAR_INITIALS value=$TOPBAR_INITIALS|cat:($TOPBAR_LAST_NAME|substr:0:1|upper)}
{/if}
{if $TOPBAR_INITIALS eq ''}
	{assign var=TOPBAR_INITIALS value={decode_html($CURRENT_USER_MODEL->get('user_name'))|substr:0:2|upper}}
{/if}
