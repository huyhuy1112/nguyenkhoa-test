{* Create Opportunity — quick tips + sales stage guide (sidebar) *}
{strip}
<aside class="mk-opp-aside" aria-label="Guidance">
	<div class="mk-opp-aside-card mk-opp-aside-card--tips">
		<div class="mk-opp-aside-card__head">
			<span class="mk-opp-aside-card__icon mk-opp-aside-card__icon--tips" aria-hidden="true">
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 2a7 7 0 0 1 7 7c0 2.4-1.2 4.5-3 5.7V17a1 1 0 0 1-1 1h-6a1 1 0 0 1-1-1v-2.3C6.2 13.5 5 11.4 5 9a7 7 0 0 1 7-7Z" stroke="currentColor" stroke-width="1.75"/><path d="M9 21h6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>
			</span>
			<h3 class="mk-opp-aside-card__title">Quick tips</h3>
		</div>
		<div class="mk-opp-aside-card__body">
			<p class="mk-opp-aside-card__text">
				Chọn <strong>Contact</strong> và <strong>Organization</strong> trước — giúp báo cáo pipeline chính xác hơn.
			</p>
			<p class="mk-opp-aside-card__text mk-opp-aside-card__text--muted">
				<strong>Amount</strong> và <strong>Expected Close Date</strong> dùng để dự báo doanh thu. <strong>Probability</strong> thường tự cập nhật theo Sales Stage.
			</p>
		</div>
	</div>

	<div class="mk-opp-aside-card mk-opp-aside-card--stages">
		<div class="mk-opp-aside-card__head">
			<span class="mk-opp-aside-card__icon mk-opp-aside-card__icon--stages" aria-hidden="true">
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M4 18h16M6 12h12M8 6h8" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>
			</span>
			<h3 class="mk-opp-aside-card__title">Sales stage guide</h3>
		</div>
		<ul class="mk-opp-stage-guide">
			<li class="mk-opp-stage-guide__item mk-opp-stage-guide__item--early">
				<span class="mk-opp-stage-guide__badge">Early</span>
				<span class="mk-opp-stage-guide__desc"><span class="mk-opp-stage-guide__stage">Prospecting</span><span class="mk-opp-stage-guide__sep"> — </span><span class="mk-opp-stage-guide__hint">tìm và xác định lead tiềm năng</span></span>
			</li>
			<li class="mk-opp-stage-guide__item mk-opp-stage-guide__item--qualify">
				<span class="mk-opp-stage-guide__badge">Qualify</span>
				<span class="mk-opp-stage-guide__desc"><span class="mk-opp-stage-guide__stage">Qualification</span><span class="mk-opp-stage-guide__sep"> / </span><span class="mk-opp-stage-guide__stage">Needs Analysis</span><span class="mk-opp-stage-guide__sep"> — </span><span class="mk-opp-stage-guide__hint">đánh giá nhu cầu</span></span>
			</li>
			<li class="mk-opp-stage-guide__item mk-opp-stage-guide__item--mid">
				<span class="mk-opp-stage-guide__badge">Mid</span>
				<span class="mk-opp-stage-guide__desc"><span class="mk-opp-stage-guide__stage">Proposal</span><span class="mk-opp-stage-guide__sep"> / </span><span class="mk-opp-stage-guide__stage">Negotiation</span><span class="mk-opp-stage-guide__sep"> — </span><span class="mk-opp-stage-guide__hint">chào giá &amp; thương lượng</span></span>
			</li>
			<li class="mk-opp-stage-guide__item mk-opp-stage-guide__item--won">
				<span class="mk-opp-stage-guide__badge">Won</span>
				<span class="mk-opp-stage-guide__desc"><span class="mk-opp-stage-guide__stage">Closed Won</span><span class="mk-opp-stage-guide__sep"> — </span><span class="mk-opp-stage-guide__hint">chốt thành công</span></span>
			</li>
			<li class="mk-opp-stage-guide__item mk-opp-stage-guide__item--lost">
				<span class="mk-opp-stage-guide__badge">Lost</span>
				<span class="mk-opp-stage-guide__desc"><span class="mk-opp-stage-guide__stage">Closed Lost</span><span class="mk-opp-stage-guide__sep"> — </span><span class="mk-opp-stage-guide__hint">không chốt được</span></span>
			</li>
		</ul>
	</div>
</aside>
{/strip}
