{* Create Support FAQ — guidance sidebar *}
{strip}
<aside class="mk-sf-faq-aside" aria-label="Guidance">
	<div class="mk-sf-faq-aside-card mk-sf-faq-aside-card--guide">
		<div class="mk-sf-faq-aside-card__head">
			<span class="mk-sf-faq-aside-card__icon mk-sf-faq-aside-card__icon--guide" aria-hidden="true">
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none">
					<path d="M4 6.5C4 5.12 5.12 4 6.5 4h11C18.88 4 20 5.12 20 6.5v7c0 1.38-1.12 2.5-2.5 2.5H11l-4 3v-3H6.5C5.12 16 4 14.88 4 13.5v-7Z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
					<path d="M8 9h8M8 12h5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
				</svg>
			</span>
			<h3 class="mk-sf-faq-aside-card__title">FAQ best practices</h3>
		</div>
		<ul class="mk-sf-faq-guide-list">
			<li class="mk-sf-faq-guide-list__item mk-sf-faq-guide-list__item--search">
				<span class="mk-sf-faq-guide-list__badge">Search</span>
				<span class="mk-sf-faq-guide-list__desc">Dùng từ khóa trong tiêu đề mô tả để agent tìm nhanh</span>
			</li>
			<li class="mk-sf-faq-guide-list__item mk-sf-faq-guide-list__item--clear">
				<span class="mk-sf-faq-guide-list__badge">Clear</span>
				<span class="mk-sf-faq-guide-list__desc">Tránh thuật ngữ nội bộ; viết cho người mới</span>
			</li>
			<li class="mk-sf-faq-guide-list__item mk-sf-faq-guide-list__item--update">
				<span class="mk-sf-faq-guide-list__badge">Update</span>
				<span class="mk-sf-faq-guide-list__desc">Cập nhật khi quy trình hoặc sản phẩm thay đổi</span>
			</li>
		</ul>
	</div>
</aside>
{/strip}

